{
  "method": "initial_noise",
  "mode": "train",
  "seed": 42,
  "max_transitions": 1000000,
  "eval_episodes": 60,
  "learning_start": 2000,
  "training_frequency": 1,
  "utd": 1.0,
  "progressive_exploration": 0,
  "replay_capacity": 100000,
  "checkpoint_every": 100000,
