{
  "extends": "table_buttons_vlajepa_eval.json",
  "name": "table_buttons_parallel_vlajepa_eval",
  "description": "Eight shared-world table-button environments with the existing medium-profile joint6 policy; a deployment example, not a measured success-rate result.",
  "task": {
    "config": {
      "num_envs": 8,
      "spacing_m": 6,
      "render_resolution": [640, 480],
      "cpu_threads": 8,
      "png_workers": 8,
      "log_dir": "${project_root}/outputs/table_buttons_parallel_vlajepa_eval/simulation"
    }
  },
  "nodes": {
    "inference": {
      "server": {"port": 18451},
      "service": {"cache_size": 64, "batch_size": 8}
    },
    "simulation": {
      "server": {"port": 18421},
      "service": {"request_cache_size": 2}
    }
  },
  "run": {
    "rollout": {"num_envs": 8, "eval_episodes": 16},
    "output_dir": "${project_root}/outputs/table_buttons_parallel_vlajepa_eval/run"
  }
}
