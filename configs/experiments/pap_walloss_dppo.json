{
  "schema_version": 1,
  "name": "pap_walloss_dppo",
  "task": {
    "plugin": "pap",
    "config": {
      "scene_config": "${project_root}/configs/piper_pick_place.json",
      "trajectory": "${project_root}/outputs/pap_dataset_audit/episode_000000.npz",
      "python": "${project_root}/.conda/envs/pressb/bin/python",
      "num_envs": 16,
      "gpu_ids": [
        0
      ],
      "horizon": 32,
      "render_resolution": [
        640,
        480
      ],
      "render_subframes": 1,
      "reset_render_frames": 2,
      "spacing_m": 6,
      "cpu_threads": 8,
      "png_workers": 8,
      "gamma": 0.995,
      "max_episode_seconds": 20,
      "smoothing": {
        "mode": "none",
        "alpha": 0.8
      },
      "randomization": {
        "position": "markers",
        "colors": [
          "red"
        ]
      },
      "reward": {
        "success": 1.0,
        "failure": 0.0
      },
      "outcome": {
        "stable_seconds": 0.5,
        "lift_height": 0.04
      },
      "terminate_on_drop": true,
      "drop_below_table_m": 0.05,
      "startup_timeout": 300,
      "command_timeout": 300,
      "renderer_profile": "rl_fast",
      "observation_render_frames": 2,
      "image_preprocessing": {
        "version": 1,
        "kind": "walloss_pil_longest_edge",
        "longest_edge": 256,
        "mode": "RGB",
        "resample": "bicubic",
        "rounding": "truncate"
      }
    }
  },
  "model": {
    "plugin": "walloss",
    "config": {
      "model_path": "/home/pengguanqi/Models/piper_pap_20260606",
      "train_config": "${project_root}/configs/model_metadata/walloss_pap_20260606.yaml",
      "norm_stats": "/home/pengguanqi/Models/piper_pap_20260606/norm_stats.json",
      "device": "cuda:0",
      "dtype": "bfloat16",
      "horizon": 32,
      "control_hz": 30,
      "num_inference_timesteps": 10,
      "input_image_resolution": 256,
      "camera_mapping": {
        "up": "face_view",
        "wrist": "left_wrist_view"
      },
      "flow_prefix_cache": false,
      "flow_prefix_cache_mode": "full_attention"
    }
  },
  "nodes": {
    "simulation": {
      "server": {
        "host": "127.0.0.1",
        "port": 18201,
        "transport": "http"
      },
      "service": {
        "request_cache_size": 2
      }
    },
    "inference": {
      "server": {
        "host": "127.0.0.1",
        "port": 18231,
        "transport": "ws",
        "max_message_bytes": 201326592
      },
      "service": {
        "cache_size": 256,
        "cache_ttl": 600,
        "batch_size": 8,
        "collect_timing": true,
        "action_expert": {
          "transition_std": 0.03,
          "denoising_steps": 10,
          "transition_microbatch_size": 8,
          "transition_context_length": 256
        }
      }
    }
  },
  "run": {
    "method": "dppo",
    "mode": "train",
    "device": "cuda:1",
    "seed": 42,
    "endpoints": {
      "inference": "ws://127.0.0.1:18231",
      "simulation": "http://127.0.0.1:18201",
      "timeout": 300,
      "max_message_bytes": 201326592
    },
    "rollout": {
      "max_transitions": 100000,
      "execution_horizon": 32,
      "eval_episodes": 100,
      "recent_window": 100,
      "num_envs": 16,
      "action_bounds": "clip"
    },
    "dppo": {
      "rollout_steps": 16,
      "epochs": 1,
      "minibatch_size": 32,
      "actor_lr": 1e-06,
      "critic_lr": 0.0003,
      "gae_lambda": 0.95,
      "bootstrap_truncated": false,
      "logprob_reduction": "upstream_mean",
      "gamma_denoising": 0.99,
      "clip_epsilon": 0.01,
      "clip_epsilon_min": 0.001,
      "target_kl": 0.05,
      "logprob_max": 2.0
    },
    "checkpoint": {
      "interval": 100000,
      "keep": null,
      "include_replay": false
    },
    "output_dir": "${project_root}/outputs/pap_walloss_dppo/run",
    "wandb": {
      "enabled": false,
      "project": "pressb-online-rl",
      "name": "pap-walloss-dppo"
    }
  },
  "description": "On-policy stochastic-flow PPO for the frozen Wall-OSS encoder and trainable action expert; configure separate inference and learner GPU resources before launch."
}
